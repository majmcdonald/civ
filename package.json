{
  "name": "civ",
  "version": "0.1.0",
  "private": true,
  "description": "Single-player, turn-based civilization strategy game inspired by Francis Tresham's Civilization (1980)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/ui/tsconfig.json && tsc -p tests/tsconfig.json && tsc -p sim/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "sim": "node sim/phase0/sim.ts",
    "batch": "node sim/run.mjs ./sim/batch.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
